@page
@model IndexModel
@{
    ViewData["Title"] = "POS Pago";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h1 class="mb-4 text-center">POS Pago</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger text-center">@Model.ErrorMessage</div>
    }

    @if (Model.PaymentId != null && string.IsNullOrEmpty(Model.Status))
    {
        <!-- Botones de acción centrados -->
        <div class="d-flex flex-column gap-3 align-items-center">
            <form method="post" asp-page-handler="Approve" class="w-50">
                <input type="hidden" asp-for="PaymentId" />
                <button class="btn btn-success btn-lg w-100">Pago OK</button>
            </form>

            <form method="post" asp-page-handler="Decline" class="w-50">
                <input type="hidden" asp-for="PaymentId" />
                <button class="btn btn-danger btn-lg w-100">Pago Rechazado</button>
            </form>

            <form method="post" asp-page-handler="Cancel" class="w-50">
                <input type="hidden" asp-for="PaymentId" />
                <button class="btn btn-secondary btn-lg w-100">Cancelar Pago</button>
            </form>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.Status))
    {
        <!-- Estado del pago centrado -->
        <div class="alert
                @(Model.Status == "APPROVED" ? "alert-success" :
                           Model.Status == "DECLINED" ? "alert-danger" :
                           "alert-warning")
            mt-3 text-center w-50 mx-auto">
        <h3>Estado del Pago: @Model.Status</h3>
    </div>

        <form method="get" class="text-center mt-3">
            <button class="btn btn-primary">Volver</button>
        </form>
        }
    else
    {
        <!-- Formulario inicial centrado -->
        <form method="post" class="d-flex flex-column gap-3 align-items-center w-50 mx-auto">
            <label for="Amount" class="form-label">Monto:</label>
            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required />

            <button type="submit" class="btn btn-primary btn-lg w-100">Pagar</button>
        </form>
    }
</div>
